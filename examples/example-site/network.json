    "jump_kit": [
      "fw",
      "ap1",
      "sw1"
    ],
    "move_out": [
      "Export the firewall configuration and copy it off the box",
      "Confirm a printed copy of this document is packed",
      "Photograph the cabinet before unplugging anything",
      "Check each cable label is on both ends",
      "Book the provider's move date"
    ],
    "phases": [
      {
        "id": "wan",
        "title": "Phase 1: Internet",
        "pause_point": "Do not continue until the firewall has a public address.",
        "steps": [
          {
            "id": "1.1",
            "action": "Connect ONT LAN 1 to firewall WAN with cable C001.",
            "killer": true,
            "verify": {
              "check": "Link light on both ends",
              "expected": "solid"
            }
          },
          {
            "id": "1.2",
            "action": "Power the firewall and restore the exported configuration.",
            "depends_on": [
              "1.1"
            ],
            "verify": {
              "check": "Open the admin page",
              "expected": "login page loads"
            }
          },
          {
            "id": "1.3",
            "action": "Enter the new provider credentials on WAN.",
            "depends_on": [
              "1.2"
            ],
            "verify": {
              "command": "ping -c3 1.1.1.1",
              "check": "Ping from the firewall",
              "expected": "0% loss"
            }
          }
        ]
      },
      {
        "id": "lan",
        "title": "Phase 2: LAN and Wi-Fi",
        "pause_point": "Do not connect servers until a client gets an address and reaches the internet.",
        "steps": [
          {
            "id": "2.1",
            "action": "Connect firewall LAN 1 to switch port 1 with C002.",
            "depends_on": [
              "1.3"
            ],
            "verify": {
              "check": "Link light",
              "expected": "solid"
            }
          },
          {
            "id": "2.2",
            "action": "Connect the AP to switch port 2 with C003.",
            "depends_on": [
              "2.1"
            ],
            "verify": {
              "check": "SSID visible",
              "expected": "ExampleNet"
            }
          }
        ]
      },
      {
        "id": "srv",
        "title": "Phase 3: Servers and remote access",
        "pause_point": "Stop and run reconstitution.",
        "steps": [
          {
            "id": "3.1",
            "action": "Connect the server and NAS using C004 and C005.",
            "depends_on": [
              "2.1"
            ],
            "verify": {
              "command": "ping -c3 192.168.50.10",
              "check": "Server answers",
              "expected": "0% loss"
            }
          },
          {
            "id": "3.2",
            "action": "Update DNS records tied to the public IP.",
            "killer": true,
            "depends_on": [
              "3.1"
            ],
            "verify": {
              "command": "dig +short home.example.net",
              "check": "Record matches the new public IP",
              "expected": "new address"
            }
          }
        ]
      }
    ],
    "reconstitution": [
      "Run a fresh scan: no device missing, no reservation wrong",
      "Tailscale reaches the firewall from outside the network",
      "Every Cloudflare tunnel hostname answers from a phone off Wi-Fi",
      "Every PACE alternate tested once by disabling the primary",
      "New public IP, date and any changes written back and a new playbook issued"
